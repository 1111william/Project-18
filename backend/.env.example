# Runtime mode: development, test, staging, or production
APP_ENV=development
DEBUG=1

# URL priority is DATABASE_URL, then MYSQL_URL, then the fields below.
# Remove or clear both URL variables when you intend these fields to apply.
# DATABASE_URL=mysql+pymysql://app:password@127.0.0.1:3306/coseat18?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=local-development-only
DB_NAME=coseat18_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=280
DB_CONNECT_TIMEOUT=10

# disabled, required, verify_ca, or verify_identity
DB_SSL_MODE=disabled
# DB_SSL_CA=/run/secrets/mysql-ca.pem
# DB_SSL_CERT=/run/secrets/mysql-client-cert.pem
# DB_SSL_KEY=/run/secrets/mysql-client-key.pem

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=86400
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=lax

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
MAX_CHILDREN_PER_PARENT=5

# Account verification delivery. Use development locally; use smtp only when
# all SMTP values are configured.
EMAIL_DELIVERY=development
AUTH_DEVELOPMENT_CODES=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Project 18
SMTP_STARTTLS=1
SMTP_TIMEOUT_SECONDS=20

# Uvicorn/container settings
PORT=8000
WEB_CONCURRENCY=1
LOG_LEVEL=info
UVICORN_ACCESS_LOG=1
TRUSTED_PROXY_HEADERS=0
# Required only when TRUSTED_PROXY_HEADERS=1. Do not default this to *.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Backwards compatibility only; prefer the explicit cookie settings above.
CROSS_SITE_COOKIE=0
